    },
    "A quota only helps while you can see it. Add one place and you will know what is left without opening the app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额度只有在你看得见的时候才有用。挑一个位置加上，之后不用打开 App 就知道还剩多少。"
          }
        }
      }
    },
